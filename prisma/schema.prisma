generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  MANAGER
  CASHIER
}

enum EquipmentType {
  KITCHEN
  BARISTA
  SHISHA
  HALL
  BATHROOM
}

enum EquipmentStatus {
  OPERATIONAL
  MAINTENANCE
  OUT_OF_SERVICE
}

enum TableType {
  FAMILY_BOOTH   // باكيات عائلات
  VIP            // طاولات VIP
  REGULAR        // طاولات عادية
  OWNER          // طاولة المالك
  MANAGER        // طاولة المدير
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
}

enum UnitType {
  KG
  GRAM
  LITER
  ML
  PIECE
  PORTION
}

enum OrderStatus {
  OPEN
  PAID
}

enum ShiftStatus {
  OPEN
  CLOSED
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  name      String
  role      Role     @default(CASHIER)
  active    Boolean  @default(true)
  orders    Order[]
  shifts    Shift[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Category {
  id          String     @id @default(cuid())
  name        String
  nameAr      String     @map("name_ar")
  description String?
  order       Int        @default(0)
  items       MenuItem[]
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@map("categories")
}

model MenuItem {
  id          String       @id @default(cuid())
  name        String
  nameAr      String       @map("name_ar")
  description String?
  price       Float
  categoryId  String       @map("category_id")
  category    Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  active      Boolean      @default(true)
  imageUrl    String?      @map("image_url")
  recipeItems RecipeItem[]
  orderItems  OrderItem[]
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@map("menu_items")
}

model RawMaterial {
  id               String                 @id @default(cuid())
  name             String
  category         String                 @default("اللحوم والدواجن")
  type             String                 @default("FOOD") // "FOOD" | "PACKAGING" | "CLEANING"
  unit             UnitType               @default(KG)
  purchaseUnit     String                 @default("كجم") @map("purchase_unit")
  issueUnit        String                 @default("جرام") @map("issue_unit")
  conversionFactor Float                  @default(1000) @map("conversion_factor")
  costPerUnit      Float                  @default(0) @map("cost_per_unit")
  currentStock     Float                  @default(0) @map("current_stock")
  minStockLevel    Float                  @default(10) @map("min_stock_level")
  status           String                 @default("OUT_OF_STOCK") // "AVAILABLE" | "OUT_OF_STOCK" | "LOW_STOCK"
  recipeItems      RecipeItem[]
  transactions     InventoryTransaction[]
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  @@map("raw_materials")
}

model RecipeItem {
  id            String      @id @default(cuid())
  menuItemId    String      @map("menu_item_id")
  menuItem      MenuItem    @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  rawMaterialId String      @map("raw_material_id")
  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)
  quantity      Float       @default(0)
  unit          UnitType    @default(GRAM)
  isComplete    Boolean     @default(false) @map("is_complete")
  status        String      @default("NEEDS_QUANTITY") @map("status") // "NEEDS_QUANTITY" | "APPROVED"
  notes         String?
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@unique([menuItemId, rawMaterialId])
  @@map("recipe_items")
}

model InventoryTransaction {
  id            String      @id @default(cuid())
  rawMaterialId String      @map("raw_material_id")
  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)
  type          String      @default("PURCHASE") // "PURCHASE" | "CONSUMPTION" | "WASTE" | "ADJUSTMENT"
  quantity      Float
  unit          String?
  unitCost      Float?      @default(0) @map("unit_cost")
  totalCost     Float?      @default(0) @map("total_cost")
  supplierName  String?     @map("supplier_name")
  notes         String?
  performedBy   String?     @map("performed_by")
  createdAt     DateTime    @default(now()) @map("created_at")

  @@map("inventory_transactions")
}

model Equipment {
  id                  String          @id @default(cuid())
  name                String
  type                String          @default("KITCHEN")
  status              EquipmentStatus @default(OPERATIONAL)
  quantity            Int             @default(1)
  unit                String?         @default("قطعة")
  unitPrice           Float?          @default(0) @map("unit_price")
  purchaseDate        DateTime?       @map("purchase_date")
  location            String?
  serialNumber        String?         @map("serial_number")
  lastMaintenanceDate DateTime?       @map("last_maintenance_date")
  notes               String?
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  @@map("equipment")
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  address   String?
  notes     String?
  orders    Order[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("customers")
}

model DiningTable {
  id        String      @id @default(cuid())
  name      String      @unique
  number    Int?
  type      TableType   @default(REGULAR)
  status    TableStatus @default(AVAILABLE)
  capacity  Int         @default(4)
  orders    Order[]
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@map("dining_tables")
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     Int         @default(autoincrement()) @map("order_number")
  orderType       OrderType   @default(DINE_IN) @map("order_type")
  tableId         String?     @map("table_id")
  table           DiningTable? @relation(fields: [tableId], references: [id])
  customerId      String?     @map("customer_id")
  customer        Customer?   @relation(fields: [customerId], references: [id])
  customerName    String?     @map("customer_name")
  customerPhone   String?     @map("customer_phone")
  deliveryAddress String?     @map("delivery_address")
  deliveryFee     Float       @default(0) @map("delivery_fee")
  userId          String?     @map("user_id")
  user            User?       @relation(fields: [userId], references: [id])
  shiftId         String?     @map("shift_id")
  shift           Shift?      @relation(fields: [shiftId], references: [id])
  status          OrderStatus @default(OPEN)
  isComplimentary Boolean     @default(false) @map("is_complimentary")
  subtotal        Float       @default(0)
  discount        Float       @default(0)
  totalAmount     Float       @default(0) @map("total_amount")
    notes           String?
  orderKind       String?     @default("NORMAL") @map("order_kind")
  customerMeatWeight Float?   @default(0) @map("customer_meat_weight")
  cookedWeight    Float?      @default(0) @map("cooked_weight")
  grillingFee     Float?      @default(0) @map("grilling_fee")
  meatType        String?     @map("meat_type")
  pricingMode     String?     @default("PER_KG") @map("pricing_mode")
  expectedPickupTime String?  @map("expected_pickup_time")
  receivedBy      String?     @map("received_by")
  deliveredBy     String?     @map("delivered_by")
  reprintCount    Int?        @default(0) @map("reprint_count")
  workflowStatus  String?     @default("NEW") @map("workflow_status")
  statusHistory   Json?       @default("[]") @map("status_history")
  riderId                 String?     @map("rider_id")
  riderName               String?     @map("rider_name")
  deliveryStatus          String?     @default("NEW") @map("delivery_status")
  remittanceStatus        String?     @default("PENDING") @map("remittance_status")
  riderCashDue            Float?      @default(0) @map("rider_cash_due")
  riderCashRemitted       Float?      @default(0) @map("rider_cash_remitted")
  riderRemittedAt         DateTime?   @map("rider_remitted_at")
  paymentMethod           String?     @default("CASH") @map("payment_method")
  cashPortion             Float?      @default(0) @map("cash_portion")
  electronicPortion       Float?      @default(0) @map("electronic_portion")
  hospitalityValue        Float?      @default(0) @map("hospitality_value")
  hospitalityReason       String?     @map("hospitality_reason")
  hospitalityApprovedBy   String?     @map("hospitality_approved_by")
  hospitalityApprovedAt   DateTime?   @map("hospitality_approved_at")
  items           OrderItem[]
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  @@map("orders")
}

model Shift {
  id              String      @id @default(cuid())
  shiftNumber     Int         @default(autoincrement()) @map("shift_number")
  userId          String      @map("user_id")
  user            User        @relation(fields: [userId], references: [id])
  startTime       DateTime    @default(now()) @map("start_time")
  endTime         DateTime?   @map("end_time")
  initialCash     Float       @default(0) @map("initial_cash")
  expectedCash    Float       @default(0) @map("expected_cash")
  actualCash      Float?      @map("actual_cash")
  shortageOverage Float?      @map("shortage_overage")
  status          ShiftStatus @default(OPEN)
  notes           String?
  orders          Order[]
  grossSales                 Float?      @default(0) @map("gross_sales")
  discounts                  Float?      @default(0) @map("discounts")
  visaAmount                 Float?      @default(0) @map("visa_amount")
  otherBalance               Float?      @default(0) @map("other_balance")
  expensesTotal              Float?      @default(0) @map("expenses_total")
  expensesDetails            Json?       @default("[]") @map("expenses_details")
  managementChecks           Float?      @default(0) @map("management_checks")
  staffWasteTotal            Float?      @default(0) @map("staff_waste_total")
  staffWasteDetails          Json?       @default("[]") @map("staff_waste_details")
  managementWithdrawalsTotal Float?      @default(0) @map("management_withdrawals_total")
  managementWithdrawalsDetails Json?     @default("[]") @map("management_withdrawals_details")
  endOfDayBalance            Float?      @default(0) @map("end_of_day_balance")
  receivedBy                 String?     @map("received_by")
  riderRemittancesTotal      Float?      @default(0) @map("rider_remittances_total")
  riderPendingDebtTotal      Float?      @default(0) @map("rider_pending_debt_total")
  riderRemittances           RiderRemittance[]
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  @@map("shifts")
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String   @map("order_id")
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String   @map("menu_item_id")
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  quantity   Int      @default(1)
  unitPrice  Float    @map("unit_price")
  totalPrice Float    @map("total_price")
    notes      String?
  weightGrams        Float?   @default(0) @map("weight_grams")
  rawWeightGrams     Float?   @default(0) @map("raw_weight_grams")
  cookedWeightGrams  Float?   @default(0) @map("cooked_weight_grams")
  isCustomerMeat     Boolean? @default(false) @map("is_customer_meat")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("order_items")
}

enum AttendanceStatus {
  PRESENT
  COMPLETED
  ABSENT
}

model Staff {
  id            String            @id @default(cuid())
  name          String
  role          String
  phone         String?
  nationalId    String?           @map("national_id")
  hourlyRate    Float?            @default(0) @map("hourly_rate")
  monthlySalary Float?            @default(0) @map("monthly_salary")
  active        Boolean           @default(true)
  notes         String?
  attendances   StaffAttendance[]
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  @@map("staff")
}

model StaffAttendance {
  id          String           @id @default(cuid())
  staffId     String           @map("staff_id")
  staff       Staff            @relation(fields: [staffId], references: [id], onDelete: Cascade)
  date        DateTime         @default(now())
  checkIn     DateTime         @default(now()) @map("check_in")
  checkOut    DateTime?        @map("check_out")
  hoursWorked Float?           @default(0) @map("hours_worked")
  shiftName   String?          @map("shift_name")
  status      AttendanceStatus @default(PRESENT)
  notes       String?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@map("staff_attendances")
}


model AuditLog {
  id        String   @id @default(cuid())
  action    String
  orderId   String?  @map("order_id")
  userId    String?  @map("user_id")
  userName  String?  @map("user_name")
  userRole  String?  @map("user_role")
  details   Json?
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

model RiderRemittance {
  id              String   @id @default(cuid())
  remittanceNumber Int     @default(autoincrement()) @map("remittance_number")
  riderId         String?  @map("rider_id")
  riderName       String   @map("rider_name")
  shiftId         String?  @map("shift_id")
  shift           Shift?   @relation(fields: [shiftId], references: [id])
  cashierId       String?  @map("cashier_id")
  cashierName     String   @map("cashier_name")
  amountExpected  Float    @default(0) @map("amount_expected")
  amountReceived  Float    @default(0) @map("amount_received")
  variance        Float    @default(0)
  varianceReason  String?  @map("variance_reason")
  orderIds        Json?    @map("order_ids")
  paymentMethod   String   @default("CASH") @map("payment_method")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("rider_remittances")
}

model HospitalityRecord {
  id              String   @id @default(cuid())
  orderId         String?  @map("order_id")
  orderNumber     Int?     @map("order_number")
  type            String   @default("FULL") // "FULL" | "ITEM" | "DISCOUNT"
  amount          Float
  reason          String
  managerId       String?  @map("manager_id")
  managerName     String   @map("manager_name")
  cashierName     String   @map("cashier_name")
  shiftId         String?  @map("shift_id")
  details         Json?
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("hospitality_records")
}
